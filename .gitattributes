# Auto detect text files and perform LF normalization
* text=auto

# TypeScript / JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf

# C#
*.cs text eol=crlf

# Shell scripts
*.sh text eol=lf

# Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
